# Copy to deploy/.env (git-ignored) and fill in.

# Your Nebius Token Factory API key. Stays on the server: the extension and the web app never see it.
NEBIUS_API_KEY=

# The VM's public IP or hostname, as your browser and VS Code reach it.
PUBLIC_HOST=

# Optional: another endpoint or NVIDIA model.
# TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
# TOKEN_FACTORY_MODEL=nvidia/nemotron-3-super-120b-a12b
